rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Admin hesabının emaili: telefon nömrəsi + @cudo-klub.vercel.app
    // Yeni admin əlavə etmək üçün siyahıya vergüllə yeni email yazın.
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email in ['ADMIN_TELEFON@cudo-klub.vercel.app'];
    }

    // İctimai saytda göstərilən klub məlumatı (ad, telefon, ünvan, cədvəl) hamıya açıqdır.
    // Yalnız klubun öz sənədi açıqdır; uşaqlar, ödənişlər və digər alt kolleksiyalar admin üçündür.
    match /clubs/{clubId} {
      allow read: if true;
    }

    // Köçürmədən əvvəlki köhnə ayar sənədi
    match /settings/club {
      allow read: if true;
    }

    match /{document=**} {
      allow read, write: if isAdmin();
    }
  }
}
